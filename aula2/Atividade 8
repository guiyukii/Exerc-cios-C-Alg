#include <stdio.h>

int main(){
    int opcao;
    float num1, num2, resultado;

opcao = 0;

while (opcao != 5) {
    printf("\n-------MENU-------\n");
    printf("1 - Soma\n");
    printf("2 - Subtracao\n");
    printf("3 - multiplicação \n");
    printf("4 - Divisão \n");
    printf("5 - Sair \n");
    printf("Escolha uma opção: \n");
    scanf("%d", &opcao);
    
    if(opcao == 1){
        printf("Digite dois números: ");
        scanf("%f %f", &num1, &num2);
        resultado = num1 + num2;
        printf("Resultado: %.2f\n", resultado);
    }

    else if(opcao == 2){
        printf("Digite dois números: ");
        scanf("%f %f", &num1, &num2);
         resultado = num1 - num2;
        printf("Resultado: %.2f\n", resultado);
    }

    else if(opcao == 3){
        printf("Digite dois números: ");
        scanf("%f %f", &num1, &num2);
         resultado = num1 * num2;
        printf("Resultado: %.2f\n", resultado);
    }

    else if(opcao == 4){
        printf("Digite dois números: ");
        scanf("%f %f", &num1, &num2);
         if (num2 == 0){
            printf("ERROR... divisão por zero não permitida.");
         } else {
            resultado = num1 / num2;
            printf("Resultado: %.2f\n", resultado);
            }
    
    }

    else if(opcao == 5){
        printf("Saindo...Até mais!\n");
    }
    else {
        printf("Opção invalida...escolha outra.\n");
    }
    }
    return 0;
}
