#include <stdio.h>
/*Atividade 3*?
int main() {

    float nota1;
    float nota2;
    float media;
    int aprovados = 0;
    int exame = 0;
    int reprovados = 0;

    for (int i = 1; i <= 10; i++) {
        printf("\nAluno %d\n", i);
        printf("Digite a primeira nota: ");
        scanf("%f", &nota1);
        printf("Digite a segunda nota: ");
        scanf("%f", &nota2);
        media = (nota1 + nota2) / 2.0;
        printf("Media: %.2f\n", media);

        if (media >= 6) {
            aprovados++;
        }
        else if (media >= 4) {
            exame++;
        }
        else {
            reprovados++;
        }
    }

    printf("Aprovados: %d\n", aprovados);
    printf("Exame: %d\n", exame);
    printf("Reprovados: %d\n", reprovados);
    return 0;
}
