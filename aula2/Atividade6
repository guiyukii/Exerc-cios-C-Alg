#include <stdio.h>

int main() {
    char palavra[50];
    int vogais = 0;
    int consoantes = 0;

    printf("Digite uma unica PALAVRA: ");
    scanf("%49s", palavra);

    for (int indice = 0; palavra[indice] != '\0'; indice++) {
        char caractere = palavra[indice];

        if (caractere == 'a' || caractere == 'e' || caractere == 'i' ||
            caractere == 'o' || caractere == 'u' || caractere == 'A' ||
            caractere == 'E' || caractere == 'I' || caractere == 'O' ||
            caractere == 'U') {
            vogais++;
        }
        else if ((caractere >= 'a' && caractere <= 'z') ||
                 (caractere >= 'A' && caractere <= 'Z')) {
            consoantes++;
        }
    }

    printf("Vogais: %d\n", vogais);
    printf("Consoantes: %d\n", consoantes);

    return 0;
}
